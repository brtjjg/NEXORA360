PORT=5000
NODE_ENV=production

# Database - Replace with your Render PostgreSQL credentials
DB_HOST=your-render-db-host
DB_PORT=5432
DB_NAME=nexora
DB_USER=nexora_user
DB_PASSWORD=your-password

# JWT
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=https://nexora360.onrender.com

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
