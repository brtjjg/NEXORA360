# backend/.env.production
NODE_ENV=production
PORT=5000

# Database - Render will provide these
DB_HOST=your-render-db-host
DB_PORT=5432
DB_NAME=nexora
DB_USER=postgres
DB_PASSWORD=your-password

# Security
JWT_SECRET=your-super-secret-jwt-key
BCRYPT_ROUNDS=12
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=https://nexora-frontend.onrender.com

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
